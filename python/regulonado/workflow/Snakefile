"""ReguloNado dataset and multi-run training workflow.

Each configured run follows its recipe's ordered phase chain. Runs are independent,
so Snakemake can schedule them concurrently while still enforcing warm starts between
phases of the same run. A run's backbone, trunk mode (live or cached embeddings) and
target (profile or region counts) decide which datasets and caches it pulls in.
"""

from pathlib import Path

from snakemake.utils import validate

from regulonado.config.models import RegulonadoConfig


# Validate the config as written, before the schema fills in defaults: several model
# validators reject options that are set but unused, and a filled-in default looks set.
_VALIDATED = RegulonadoConfig.model_validate(config)
validate(config, str(Path(workflow.basedir) / "schemas" / "config.schema.yaml"))
# The schema only fills defaults inside sections that are present; these may be omitted.
for _section in ("scaling", "qc", "targets"):
    config[_section] = getattr(_VALIDATED, _section).model_dump(mode="json")

# One track table serves every run: bigWigs when a profile target is configured (rows
# also carry their BAM for region-count runs), otherwise BAMs.
TRACK_FORMAT = _VALIDATED.track_format()
PROFILE = config["targets"]["profile"]
REGION_COUNTS = config["targets"]["region_counts"]

if config["scaling"]["method"] == "bamnado" and not config["inputs"].get("bam_dir"):
    raise ValueError("inputs.bam_dir is required when scaling.method is 'bamnado'")

SEQNADO_PROJECTS = config["inputs"].get("seqnado_projects") or []

if config["scaling"]["method"] == "seqnado":
    # SeqNado's normalisation factors are only comparable within one project, so
    # reusing them across an aggregated dataset would put tracks on different
    # scales without saying so. TMM is derived from the merged dataset instead.
    # Naming a single project does not rescue an aggregated dataset: tracks from
    # the other projects have no entry in that project's table, so scaling would
    # fail once it ran. Reject it here instead.
    if len(SEQNADO_PROJECTS) > 1:
        raise ValueError(
            "scaling.method 'seqnado' reuses one project's normalisation factors, "
            f"but {len(SEQNADO_PROJECTS)} projects are configured. Use scaling.method "
            "'tmm' — it is derived from the merged dataset and so is comparable "
            "across all of them."
        )
    if not SEQNADO_PROJECTS and not config["scaling"].get("seqnado_project"):
        raise ValueError(
            "scaling.method 'seqnado' requires scaling.seqnado_project or "
            "inputs.seqnado_projects"
        )


def seqnado_scaling_project():
    """The project whose normalisation factors scaling.method 'seqnado' reuses."""
    explicit = config["scaling"].get("seqnado_project")
    if explicit:
        return explicit
    return SEQNADO_PROJECTS[0]["path"]


RESULTS = Path(config["results_dir"])
DATASET_DIR = RESULTS / "dataset"
TRAIN_DIR = RESULTS / "train"

TRAIN = config.get("train")
RUNS = TRAIN["runs"] if TRAIN else []
RECIPES = TRAIN["recipes"] if TRAIN else {}
RUN_NAMES = [run["name"] for run in RUNS]
RUN_BY_NAME = {run["name"]: run for run in RUNS}
# Every phase name any recipe uses: the train rules' {phase} wildcard.
PHASE_NAMES = sorted({phase["name"] for phases in RECIPES.values() for phase in phases})
CACHED_RUNS = [run for run in RUNS if run.get("trunk", "live") == "cached"]
# Prediction, attribution and design read profile models; they default to all of them.
PROFILE_RUN_NAMES = [run["name"] for run in RUNS if run.get("target", "profile") == "profile"]


def run_phases(run):
    """*run*'s phases, in recipe order."""
    return RECIPES[RUN_BY_NAME[run]["recipe"]]


def run_phase(run, phase):
    return next(item for item in run_phases(run) if item["name"] == phase)


def phase_index(run, phase):
    return [item["name"] for item in run_phases(run)].index(phase)


def final_phase(run):
    """The last phase of *run*'s recipe: the checkpoint downstream stages read."""
    return run_phases(run)[-1]["name"]


def phase_run_dir(run, phase):
    return TRAIN_DIR / run / phase


def previous_phase_dir(run, phase):
    index = phase_index(run, phase)
    return None if index == 0 else phase_run_dir(run, run_phases(run)[index - 1]["name"])


def previous_phase_state(wildcards):
    """Chain a phase only to the preceding phase of the same run."""
    previous = previous_phase_dir(wildcards.run, wildcards.phase)
    return [] if previous is None else str(previous / "trainer_state.json")


def training_dataset_dir():
    return DATASET_DIR


DESIGN = config.get("design")
ATTRIBUTION = config.get("attribution")
PARAMETER_SWEEP = config.get("parameter_sweep")
PREDICTION = config.get("prediction")
_QC_ENABLED = bool(config["qc"].get("checks"))


rule all:
    input:
        *(
            str(TRAIN_DIR / run / final_phase(run) / "trainer_state.json")
            for run in RUN_NAMES
        ),
        # With no runs, build what training would consume.
        *([str(DATASET_DIR / "README.md")] if PROFILE and not TRAIN else []),
        *(
            [str(RESULTS / "region_counts" / "dataset" / "counts.parquet")]
            if REGION_COUNTS and not TRAIN
            else []
        ),
        *([str(RESULTS / "tracks" / "_stages" / "qc_report.parquet")] if _QC_ENABLED else []),
        *(
            expand(
                str(RESULTS / "design" / "{target}" / "designs.tsv"),
                target=[target["name"] for target in DESIGN["targets"]],
            )
            if DESIGN
            else []
        ),
        *(
            [str(RESULTS / "parameter-sweep" / "sweep.done")]
            if PARAMETER_SWEEP and PARAMETER_SWEEP.get("enabled", False)
            else []
        ),
        *(
            [str(RESULTS / "predictions" / PREDICTION["run"] / ".complete")]
            if PREDICTION
            else []
        ),
        *(
            expand(
                str(RESULTS / "attribution" / "{target}" / "core_regions.bed"),
                target=[target["name"] for target in ATTRIBUTION["targets"]],
            )
            if ATTRIBUTION
            else []
        ),



if PROFILE or REGION_COUNTS:
    include: "rules/tracks.smk"
if TRACK_FORMAT == "bigwig":
    include: "rules/scaling.smk"
if PROFILE:
    include: "rules/dataset.smk"
if REGION_COUNTS:
    include: "rules/region_counts.smk"
if CACHED_RUNS:
    include: "rules/embeddings.smk"
if TRAIN:
    include: "rules/train.smk"
include: "rules/predict.smk"
include: "rules/parameter_sweep.smk"
include: "rules/attribute.smk"
include: "rules/design.smk"
